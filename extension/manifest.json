{
  "manifest_version": 3,
  "name": "XL-Flow | Student Schedule & Attendance",
  "version": "1.0.0",
  "description": "Real-time class schedule, room venues, and attendance tracking for XLRI students.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Open XL-Flow",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "alarms",
    "tabs"
  ],
  "host_permissions": [
    "https://xlerp.xlri.ac.in/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://xlerp.xlri.ac.in/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["dist/*", "icons/*"],
      "matches": ["https://xlerp.xlri.ac.in/*"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src https://xlerp.xlri.ac.in"
  }
}
